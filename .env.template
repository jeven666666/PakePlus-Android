# ==============================================
# Agnes AI Studio - 环境变量配置模板
# ==============================================
# 请复制此文件为 .env 并填入实际值
# 
# 部署平台配置：
# ==============================================

# ==============================================
# 后端环境变量 (server/.env)
# ==============================================

# 服务器配置
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# JWT 密钥（重要：生产环境必须修改！）
# 生成方法：在终端运行：openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# 数据库配置
DB_PATH=./data/agnes.db

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
# 开发环境：http://localhost:5173,http://localhost:5174,http://localhost:5175
# 生产环境：填写你的前端域名，多个用逗号分隔
CORS_ORIGIN=https://your-app.vercel.app,https://your-app.pages.dev

# 日志配置
LOG_LEVEL=info

# 速率限制配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# 前端环境变量 (.env)
# ==============================================

# API 地址（生产环境填写实际后端地址）
VITE_API_URL=/api

# 网站标题
VITE_APP_TITLE=Agnes AI Studio

# 开发环境端口
VITE_PORT=5175

# ==============================================
# 部署平台特定配置
# ==============================================

# Railway (后端)
# RAILWAY_TOKEN=your-railway-token
# RAILWAY_PROJECT_ID=your-project-id

# Vercel (前端)
# 前端构建时会自动注入，无需手动配置

# Cloudflare Pages (前端)
# CF_API_TOKEN=your-cloudflare-token
# CF_ACCOUNT_ID=your-account-id

# ==============================================
# 一键部署命令
# ==============================================

# 方式1: Railway + Vercel（推荐免费方案）
# 1. Railway: https://railway.app
# 2. Vercel: https://vercel.com

# 方式2: Render + Netlify
# 1. Render: https://render.com
# 2. Netlify: https://netlify.com

# 方式3: Cloudflare（完全免费边缘部署）
# 1. Cloudflare Pages: 前端部署
# 2. Cloudflare Workers: 后端部署

# ==============================================
# 数据库初始化
# ==============================================

# 首次部署后，需要创建管理员账户：
# cd server
# npm run create-admin
